# Backend API URL (server-side only - for API routes)
# For local development: http://localhost:8080
# For production: https://your-render-backend.onrender.com
BACKEND_API_URL=http://localhost:8080

# Backend API URL (client-side - for browser components)
# For local development: http://localhost:8080
# For production: https://your-render-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8080

# Alternative backend URL variable (used in some components)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# Booking URL (optional)
NEXT_PUBLIC_BOOKING_URL=

# Add any other environment variables below
